# --- Server ---
PORT=4000
NODE_ENV=development

# PostgreSQL ulanishi. Lokal: `npm run db:local` (PGlite) yoki docker postgres.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Uzun tasodifiy satr: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web)
# Frontenddagi VITE_GOOGLE_CLIENT_ID bilan bir xil bo'lishi kerak.
GOOGLE_CLIENT_ID=

# Resend.com API kaliti. Bo'sh bo'lsa kodlar server konsoliga chiqariladi (faqat lokal uchun).
RESEND_API_KEY=
FROM_EMAIL=Prepzone <verify@mail.prep-zone.uz>

# Frontend boshqa domenda bo'lsa (masalan Vercel): https://prep-zone.uz
# Caddy orqali bitta domenda ishlasa bo'sh qoldiring.
CLIENT_ORIGIN=

# Google AI Studio (aistudio.google.com -> Get API key). Admin panelda savollarni
# PDF/rasm/matndan AI bilan import qilish va adaptiv test uchun savol yaratish.
# Tekin tarifda yuborilgan ma'lumot Google mahsulotlarini yaxshilashda ishlatilishi mumkin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Asosiy model band bo'lsa navbat bilan sinaladi (vergul bilan).
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Study Room: video brauzerlar orasida P2P. TURN relay (coturn) — production'da
# docker-compose.yml beradi. Lokal: bo'sh qoldirsa faqat STUN (P2P) ishlaydi.
TURN_SECRET=
TURN_URLS=
