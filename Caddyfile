# Caddy — HTTPS sertifikatni (Let's Encrypt) avtomatik oladi va yangilaydi.
# DOMAIN .env faylidan olinadi (masalan: prep-zone.uz).
{$DOMAIN} {
	encode zstd gzip

	# API va real-time ulanishlar Node.js serverga
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /socket.io/* {
		reverse_proxy api:4000
	}

	# Qolgan hamma narsa — React ilova (SPA: noma'lum yo'llar index.html'ga)
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html har doim yangisi olinsin — deploy'dan keyin eski chunk nomlariga murojaat qilinmasin.
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=()"
		# Google kirish oynasi (popup) natijani qaytara olishi uchun.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}
}

# www -> asosiy domen (doimiy redirect)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
