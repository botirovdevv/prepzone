# Caddy — HTTPS sertifikatni (Let's Encrypt) avtomatik oladi va yangilaydi.
# DOMAIN .env faylidan olinadi (masalan: prep-zone.uz).
{$DOMAIN} {
	encode zstd gzip

	# API va real-time ulanishlar Node.js serverga
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /socket.io/* {
		reverse_proxy api:4000
	}

	# Qolgan hamma narsa — React ilova (SPA: noma'lum yo'llar index.html'ga)
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html har doim yangisi olinsin — deploy'dan keyin eski chunk nomlariga murojaat qilinmasin.
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		# CSP: skript faqat o'zimizdan, Google kirish va Desmos'dan; begona saytga
		# iframe ichida ochilmaydi; plaginlar va <base> almashtirish taqiqlangan.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/ https://www.desmos.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/ https://www.desmos.com; font-src 'self' data: https://fonts.gstatic.com https://www.desmos.com; img-src 'self' data: blob: https:; connect-src 'self' wss://{$DOMAIN} https://accounts.google.com/gsi/ https://www.googleapis.com https://www.desmos.com; frame-src https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Permitted-Cross-Domain-Policies "none"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Study Room: kamera, mikrofon va ekran ulashish faqat o'z saytimizda.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
		# Google kirish oynasi (popup) natijani qaytara olishi uchun.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}
}

# www -> asosiy domen (doimiy redirect)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
