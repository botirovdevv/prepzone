rules_version = '2';

// ------------------------------------------------------------------
// Prepzone — Firestore Security Rules.
// Firebase Console -> Firestore Database -> Rules ga to'liq nusxalab,
// "Publish" bosing.
//
// Tamoyillar:
//  - Har kim faqat o'z ma'lumotini yozadi/o'qiydi; admin — hammasini o'qiydi.
//  - Natija/reyting yozish faqat emaili tasdiqlangan userlarga.
//  - Yoziladigan hujjatlarda ruxsat etilgan maydonlar va qiymat chegaralari
//    tekshiriladi (soxta ball, ortiqcha katta ma'lumot yozishni qiyinlashtiradi).
//    Eslatma: ballar brauzerda hisoblangani uchun bu 100% himoya emas —
//    to'liq himoya uchun ballni serverda (Cloud Functions) hisoblash kerak.
//  - Test kirish kodlari faqat aniq kod bilan o'qiladi, ro'yxatini olib bo'lmaydi.
// ------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // admins/{uid} hujjati mavjud bo'lsa — admin (src/context/AdminContext.jsx).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function data() {
      return request.resource.data;
    }

    function shortString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // IELTS band: 0–9, 0.5 qadam bilan.
    function validBand(b) {
      return b is number && b >= 0 && b <= 9 && b * 2 == math.floor(b * 2);
    }

    // Ro'yxatdan o'tishdagi so'rovnoma (src/pages/ChooseExam.jsx).
    function validOnboarding(o) {
      return o is map
        && o.keys().hasOnly(['source', 'sourceOther', 'exams', 'targets', 'completedAt'])
        && o.source in ['instagram', 'telegram', 'friends', 'other']
        && shortString(o.get('sourceOther', null), 60)
        && o.exams is list && o.exams.size() >= 1 && o.exams.size() <= 2
        && o.exams.hasOnly(['sat', 'ielts'])
        && o.targets is map
        && o.targets.keys().hasOnly(['sat', 'ielts'])
        && (!('sat' in o.targets) || (o.targets.sat is int
            && o.targets.sat >= 400 && o.targets.sat <= 1600 && o.targets.sat % 10 == 0))
        && (!('ielts' in o.targets) || validBand(o.targets.ielts));
    }

    function validIeltsSection(d, key, maxRaw) {
      return !(key in d) || (
        d[key] is map
        && validBand(d[key].band)
        && (!('raw' in d[key]) || (d[key].raw is int && d[key].raw >= 0 && d[key].raw <= maxRaw))
      );
    }

    // ---------------- Adminlar ro'yxati ----------------
    // Faqat Console orqali qo'shiladi; user faqat o'z hujjatini tekshira oladi.
    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // ---------------- User profillari ----------------
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && data().keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'emailVerified', 'createdAt',
          'lastSeenAt', 'pageViews', 'pages', 'exam', 'studyPlan', 'onboarding'
        ])
        && (!('uid' in data()) || data().uid == uid)
        && shortString(data().get('displayName', null), 100)
        && shortString(data().get('email', null), 200)
        && (!('exam' in data()) || data().exam in ['sat', 'ielts'])
        && (!('pages' in data()) || data().pages is map)
        && (!('studyPlan' in data()) || data().studyPlan is map)
        && (!('onboarding' in data()) || validOnboarding(data().onboarding));
      allow delete: if isAdmin();
    }

    // ---------------- Analitika ----------------
    // Eski format (bitta kunlik hujjat) — faqat o'qish, yangi yozuvlar shardlarga.
    match /analytics/{day} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }

    // Kunlik hisoblagich bo'laklari: analyticsShards/{kun}_{0..19}
    match /analyticsShards/{shardId} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && data().keys().hasOnly(['date', 'views', 'pages'])
        && data().date is string && data().date.size() == 10
        && shardId.matches(data().date + '_[0-9]{1,2}')
        && data().views is int
        && data().pages is map;
    }

    // Kunlik faol userlar: analyticsVisitors/{kun}_{uid}
    match /analyticsVisitors/{visitId} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && data().keys().hasOnly(['date', 'uid'])
        && data().uid == request.auth.uid
        && data().date is string && data().date.size() == 10
        && visitId == data().date + '_' + request.auth.uid;
    }

    // ---------------- SAT natijalari (+ sessiya nusxalari) ----------------
    match /results/{resultId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verified()
        && data().uid == request.auth.uid
        && data().keys().hasOnly([
          'uid', 'email', 'testId', 'results', 'total', 'createdAt',
          'terminated', 'terminationReason', 'sessionId', 'sessionTitle'
        ])
        && data().total is number && data().total >= 0 && data().total <= 1600
        && data().results is map
        && data().createdAt == request.time
        && shortString(data().get('sessionTitle', null), 200);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- IELTS natijalari ----------------
    match /ieltsResults/{resultId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verified()
        && data().uid == request.auth.uid
        && data().keys().hasOnly([
          'uid', 'email', 'testId', 'testTitle', 'mode', 'listening', 'reading', 'writing',
          'overall', 'terminated', 'terminationReason', 'createdAt'
        ])
        && data().mode in ['full', 'listening', 'reading', 'writing']
        && (data().overall == null || validBand(data().overall))
        && validIeltsSection(data(), 'listening', 40)
        && validIeltsSection(data(), 'reading', 40)
        && validIeltsSection(data(), 'writing', 0)
        && data().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- Reyting ----------------
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && verified()
        && data().keys().hasOnly(['uid', 'name', 'bestScore', 'updatedAt'])
        && data().uid == uid
        && data().name is string && data().name.size() <= 60
        && data().bestScore is int
        && data().bestScore >= 200 && data().bestScore <= 1600
        && data().bestScore % 10 == 0
        && data().updatedAt == request.time
        // Ball faqat oshishi mumkin.
        && (resource == null || data().bestScore > resource.data.bestScore);
      allow delete: if isAdmin();
    }

    // ---------------- Amaliyot to'plamlari ----------------
    match /questionSets/{setId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------------- Test kirish kodlari ----------------
    // Talaba faqat aniq kodni bilsa o'qiy oladi (`get`); ro'yxat (`list`) yopiq.
    match /sessionCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---------------- Mock test sessiyalari ----------------
    match /testSessions/{sessionId} {
      function session() {
        return get(/databases/$(database)/documents/testSessions/$(sessionId)).data;
      }

      function isParticipant() {
        return signedIn() && exists(
          /databases/$(database)/documents/testSessions/$(sessionId)/participants/$(request.auth.uid));
      }

      // Meta-ma'lumot (nom, jadval, bo'limlar nomi). Savollar va kod bu yerda EMAS.
      allow read: if signedIn();
      allow write: if isAdmin();

      // secure/content — savollar va to'g'ri javoblar (admin + qo'shilgan ishtirokchi);
      // secure/admin — kirish kodi (faqat admin).
      match /secure/{docId} {
        allow read: if isAdmin() || (docId == 'content' && isParticipant());
        allow write: if isAdmin();
      }

      // Ishtirokchi: o'zini faqat to'g'ri kod bilan (yoki ochiq testga) qo'sha oladi.
      match /participants/{uid} {
        allow read: if isAdmin() || isSelf(uid);
        allow create: if isSelf(uid) && verified()
          && shortString(data().get('name', null), 100)
          && (
            session().accessType == 'open'
            || (data().enteredCode is string
                && get(/databases/$(database)/documents/sessionCodes/$(data().enteredCode)).data.sessionId == sessionId)
            // Hali ko'chirilmagan eski sessiyalar (kod asosiy hujjatda).
            || data().enteredCode == session().code
          );
        // Holatni yangilash mumkin, lekin kiritilgan kodni o'zgartirib bo'lmaydi
        // (admin kodni yangilasa ham, test davom etayotganlar bloklanmaydi).
        allow update: if isSelf(uid)
          && data().enteredCode == resource.data.enteredCode;
        allow delete: if isAdmin();
      }

      // Proktoring hodisalari (ogohlantirishlar) — admin monitoring uchun.
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if signedIn() && isParticipant()
          && data().uid == request.auth.uid
          && data().type is string && data().type.size() <= 40
          && data().message is string && data().message.size() <= 300
          && shortString(data().get('name', null), 100);
        allow update, delete: if isAdmin();
      }

      // Sessiya natijasi (asosiy nusxa).
      match /results/{uid} {
        allow read: if isAdmin() || isSelf(uid);
        allow create, update: if isSelf(uid) && verified() && isParticipant()
          && data().uid == uid
          && data().total is number && data().total >= 0 && data().total <= 1600;
        allow delete: if isAdmin();
      }
    }

    // Qolgan hamma narsa yopiq.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
