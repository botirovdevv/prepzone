rules_version = '2';

// ------------------------------------------------------------------
// Prepzone — Firestore Security Rules.
// Firebase Console -> Firestore Database -> Rules ga to'liq nusxalab,
// "Publish" bosing (yoki: firebase deploy --only firestore:rules).
//
// Tamoyillar:
//  - Har kim faqat o'z ma'lumotini o'qiydi/yozadi; admin — hammasini o'qiydi.
//  - Ball, natija va reyting FAQAT serverda (Vercel API, Admin SDK)
//    hisoblanib yoziladi — client bu kolleksiyalarga yoza olmaydi.
//    Admin SDK rules'ni chetlab o'tadi, shuning uchun bu yerda
//    "allow create: if false" server yozuvlariga to'sqinlik qilmaydi.
//  - To'g'ri javoblar clientga berilmaydi: sessiyalarda secure/answers
//    (faqat admin), ishtirokchilar secure/content (kalitsiz) ni o'qiydi.
//  - Test kirish kodlari faqat aniq kod bilan o'qiladi, ro'yxatini olib bo'lmaydi.
// ------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // admins/{uid} hujjati mavjud bo'lsa — admin (src/context/AdminContext.jsx).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function data() {
      return request.resource.data;
    }

    function shortString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // IELTS band: 0–9, 0.5 qadam bilan.
    function validBand(b) {
      return b is number && b >= 0 && b <= 9 && b * 2 == math.floor(b * 2);
    }

    // "YYYY-MM-DD" — bugun (vaqt zonalari farqi uchun ±1 kun).
    function isRecentDay(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(d.split('-')[0]), int(d.split('-')[1]), int(d.split('-')[2]))
             > request.time - duration.value(2, 'd')
        && timestamp.date(int(d.split('-')[0]), int(d.split('-')[1]), int(d.split('-')[2]))
             < request.time + duration.value(1, 'd');
    }

    // Hisoblagich bir yozuvda faqat 1..max ga oshishi mumkin.
    function bumpedBy(field, max) {
      return data()[field] is int
        && data()[field] - (resource == null ? 0 : resource.data.get(field, 0)) >= 1
        && data()[field] - (resource == null ? 0 : resource.data.get(field, 0)) <= max;
    }

    // Ro'yxatdan o'tishdagi so'rovnoma (src/pages/ChooseExam.jsx).
    function validOnboarding(o) {
      return o is map
        && o.keys().hasOnly(['source', 'sourceOther', 'exams', 'targets', 'completedAt'])
        && o.source in ['instagram', 'telegram', 'friends', 'other']
        && shortString(o.get('sourceOther', null), 60)
        && o.exams is list && o.exams.size() >= 1 && o.exams.size() <= 2
        && o.exams.hasOnly(['sat', 'ielts'])
        && o.targets is map
        && o.targets.keys().hasOnly(['sat', 'ielts'])
        && (!('sat' in o.targets) || (o.targets.sat is int
            && o.targets.sat >= 400 && o.targets.sat <= 1600 && o.targets.sat % 10 == 0))
        && (!('ielts' in o.targets) || validBand(o.targets.ielts));
    }

    // ---------------- Adminlar ro'yxati ----------------
    // Faqat Console orqali qo'shiladi; user faqat o'z hujjatini tekshira oladi.
    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // ---------------- User profillari ----------------
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && data().keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'emailVerified', 'createdAt',
          'lastSeenAt', 'pageViews', 'pages', 'exam', 'studyPlan', 'onboarding'
        ])
        && (!('uid' in data()) || data().uid == uid)
        && shortString(data().get('displayName', null), 100)
        && shortString(data().get('email', null), 200)
        && (!('exam' in data()) || data().exam in ['sat', 'ielts'])
        && (!('pageViews' in data()) || data().pageViews is int)
        && (!('pages' in data()) || (data().pages is map && data().pages.size() <= 40))
        && (!('studyPlan' in data()) || data().studyPlan is map)
        && (!('onboarding' in data()) || validOnboarding(data().onboarding));
      allow delete: if isAdmin();
    }

    // ---------------- Analitika ----------------
    // Eski format (bitta kunlik hujjat) — faqat o'qish.
    match /analytics/{day} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }

    // Kunlik hisoblagich bo'laklari: analyticsShards/{kun}_{0..19}
    match /analyticsShards/{shardId} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && data().keys().hasOnly(['date', 'views', 'pages'])
        && isRecentDay(data().date)
        && shardId.matches(data().date + '_[0-9]{1,2}')
        && bumpedBy('views', 500)
        && data().pages is map && data().pages.size() <= 40;
    }

    // Kunlik faol userlar: analyticsVisitors/{kun}_{uid}
    match /analyticsVisitors/{visitId} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && data().keys().hasOnly(['date', 'uid'])
        && data().uid == request.auth.uid
        && isRecentDay(data().date)
        && visitId == data().date + '_' + request.auth.uid;
    }

    // O'tgan kunlar uchun yig'ma (admin Analytics sahifasi yozadi).
    match /analyticsDaily/{day} {
      allow read, write: if isAdmin();
    }

    // ---------------- Natijalar (faqat server yozadi) ----------------
    match /results/{resultId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /ieltsResults/{resultId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- Reyting (faqat server yozadi) ----------------
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if false;
      allow delete: if isAdmin();
    }

    // Server uchun kunlik limit hisoblagichlari.
    match /rateLimits/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------- Amaliyot to'plamlari ----------------
    match /questionSets/{setId} {
      allow read: if verified();
      allow write: if isAdmin();

      // Savollardagi rasmlar (src/utils/setImages.js) — asosiy hujjat
      // 1 MiB limitdan oshmasligi uchun alohida saqlanadi.
      match /images/{imageId} {
        allow read: if verified();
        allow write: if isAdmin();
      }
    }

    // Yengil ro'yxat (nom, tavsif, savollar soni) — PracticeIndex uchun.
    match /questionSetIndex/{setId} {
      allow read: if verified();
      allow write: if isAdmin();
    }

    // ---------------- Test kirish kodlari ----------------
    // Talaba faqat aniq kodni bilsa o'qiy oladi (`get`); ro'yxat (`list`) yopiq.
    match /sessionCodes/{code} {
      allow get: if verified();
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---------------- Mock test sessiyalari ----------------
    match /testSessions/{sessionId} {
      function session() {
        return get(/databases/$(database)/documents/testSessions/$(sessionId)).data;
      }

      function isParticipant() {
        return signedIn() && exists(
          /databases/$(database)/documents/testSessions/$(sessionId)/participants/$(request.auth.uid));
      }

      // Boshlanish vaqti kelgan va yopilmagan.
      function sessionOpenNow() {
        return session().get('status', 'scheduled') != 'closed'
          && (session().get('accessType', 'code') == 'open'
              || session().get('scheduledAt', null) == null
              || request.time >= session().scheduledAt);
      }

      // Meta-ma'lumot (nom, jadval, bo'limlar nomi). Savollar va kod bu yerda EMAS.
      allow read: if signedIn();
      allow write: if isAdmin();

      // secure/content — savollar (to'g'ri javoblarsiz): ishtirokchi, test vaqtida;
      // secure/answers — savollar kalitlar bilan (faqat admin va server);
      // secure/admin — kirish kodi (faqat admin).
      match /secure/{docId} {
        allow read: if isAdmin() || (docId == 'content' && isParticipant() && sessionOpenNow());
        allow write: if isAdmin();
      }

      // Ishtirokchi: o'zini faqat to'g'ri kod bilan (yoki ochiq testga) qo'sha oladi.
      match /participants/{uid} {
        allow read: if isAdmin() || isSelf(uid);
        allow create: if isSelf(uid) && verified()
          && data().keys().hasOnly(['uid', 'name', 'email', 'status', 'joinedAt', 'enteredCode'])
          && data().uid == uid
          && data().status == 'not_started'
          && shortString(data().get('name', null), 100)
          && shortString(data().get('email', null), 200)
          && (
            session().accessType == 'open'
            || (data().enteredCode is string
                && get(/databases/$(database)/documents/sessionCodes/$(data().enteredCode)).data.sessionId == sessionId)
            // Hali ko'chirilmagan eski sessiyalar (kod asosiy hujjatda).
            || data().enteredCode == session().code
          );
        // Talaba faqat o'z holatini (boshladi/pauza/chetlatildi) va
        // ogohlantirishlar sonini yangilaydi. Yakunlangan/chetlatilgan
        // holatdan qaytib bo'lmaydi, ogohlantirishlar kamaytirilmaydi,
        // ball (totalScore) va "finished" faqat serverdan.
        allow update: if isSelf(uid)
          && data().diff(resource.data).affectedKeys()
               .hasOnly(['status', 'startedAt', 'violationCount', 'terminationReason', 'terminatedAt'])
          && !(resource.data.get('status', '') in ['finished', 'terminated'])
          && data().get('status', '') in ['not_started', 'active', 'paused', 'terminated']
          && data().get('violationCount', 0) is int
          && data().get('violationCount', 0) >= resource.data.get('violationCount', 0)
          && shortString(data().get('terminationReason', null), 40);
        allow delete: if isAdmin();
      }

      // Proktoring hodisalari (ogohlantirishlar) — admin monitoring uchun.
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isParticipant()
          && data().keys().hasOnly(['uid', 'name', 'type', 'message', 'at'])
          && data().uid == request.auth.uid
          && data().at == request.time
          && data().type is string && data().type.size() <= 40
          && data().message is string && data().message.size() <= 300
          && shortString(data().get('name', null), 100);
        allow update, delete: if isAdmin();
      }

      // Sessiya natijasi (faqat server yozadi).
      match /results/{uid} {
        allow read: if isAdmin() || isSelf(uid);
        allow create, update: if false;
        allow delete: if isAdmin();
      }
    }

    // Qolgan hamma narsa yopiq.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
