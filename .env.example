# --- Frontend (Vite) ---
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# server/.env dagi GOOGLE_CLIENT_ID bilan bir xil.
VITE_GOOGLE_CLIENT_ID=

# Desmos kalkulyatori API kaliti (https://www.desmos.com/my-api). Bo'sh bo'lsa
# Desmos'ning umumiy demo kaliti ishlatiladi — u faqat sinov uchun mo'ljallangan.
VITE_DESMOS_API_KEY=

# Faqat frontend API'dan boshqa domenda joylashsa (masalan Vercel): https://api.prep-zone.uz
# Caddy orqali bitta domenda ishlasa bo'sh qoldiring.
VITE_API_URL=

# --- docker-compose (faqat serverda) ---
DOMAIN=prep-zone.uz
POSTGRES_PASSWORD=
