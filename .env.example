# ------------------------------------------------------------------
# Nusxa oling: .env (lokal) — va xuddi shu kalitlarni Vercel ->
# Project -> Settings -> Environment Variables ga kiriting.
# Qo'shtirnoqsiz yozing. O'zgartirgandan keyin `npm run dev` ni qayta ishga tushiring.
# ------------------------------------------------------------------

# --- Brauzer (public) — Firebase Console -> Project settings -> Your apps -> Web app ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desmos kalkulyator — hozircha ishlatilmaydi (tez orada). Production kaliti: https://www.desmos.com/my-api
VITE_DESMOS_API_KEY=

# --- Faqat server (api/) — HECH QACHON VITE_ prefiksi bilan yozmang ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# JSON faylning butun mazmuni BITTA qatorda:
FIREBASE_SERVICE_ACCOUNT=

# IELTS Writing AI baholash — hozircha o'chiq (tez orada, api/ielts/submit.js AI_WRITING_ENABLED): https://console.anthropic.com -> API keys.
# Bo'sh qolsa — Writing avtomatik (taxminiy) baholanadi.
ANTHROPIC_API_KEY=
# Ixtiyoriy: claude-sonnet-5 (standart) yoki arzonroq claude-haiku-4-5
AI_WRITING_MODEL=claude-sonnet-5
